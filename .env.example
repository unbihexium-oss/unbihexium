# Example environment variables for running Unbihexium locally or with Docker Compose.
# Copy this file to .env and adjust the values. Never commit the .env file.

# Base directory for the model cache. Models are stored in $UNBIHEXIUM_CACHE/models.
# Default when unset: ~/.cache/unbihexium/models
UNBIHEXIUM_CACHE=~/.cache/unbihexium

# Home directory of the unbihexium user in the container image (see Dockerfile).
UNBIHEXIUM_HOME=/home/unbihexium
