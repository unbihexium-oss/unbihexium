# =============================================================================
# .env.example: environment variables for Unbihexium
# =============================================================================
#
# Copy this file to .env and adjust the values. docker-compose.yml reads .env
# automatically; for local runs, export the variables in your shell or use a
# tool such as direnv. Never commit the .env file: it may contain credentials.
#
# Every variable is optional. Commented-out variables show their default or an
# example value.
# =============================================================================

# -----------------------------------------------------------------------------
# Unbihexium
# -----------------------------------------------------------------------------

# Base directory of the model cache. Models are stored in
# $UNBIHEXIUM_CACHE/models and verified with SHA256 after download.
# Default when unset: ~/.cache/unbihexium/models
UNBIHEXIUM_CACHE=~/.cache/unbihexium

# Home directory of the unbihexium user in the container image (Dockerfile).
UNBIHEXIUM_HOME=/home/unbihexium

# -----------------------------------------------------------------------------
# Python runtime
# -----------------------------------------------------------------------------

# Write log output immediately, which is recommended in containers.
PYTHONUNBUFFERED=1

# Do not write .pyc files, for example on read-only file systems.
# PYTHONDONTWRITEBYTECODE=1

# -----------------------------------------------------------------------------
# GDAL and rasterio (raster input and output)
# https://gdal.org/en/stable/user/configoptions.html
# -----------------------------------------------------------------------------

# Size of the GDAL block cache in megabytes.
# GDAL_CACHEMAX=512

# Threads used by GDAL for compression and warping (ALL_CPUS or a number).
# GDAL_NUM_THREADS=ALL_CPUS

# Speed up opening Cloud Optimized GeoTIFFs over HTTP and S3.
# GDAL_DISABLE_READDIR_ON_OPEN=EMPTY_DIR
# CPL_VSIL_CURL_ALLOWED_EXTENSIONS=.tif,.tiff,.jp2,.vrt

# Access to public S3 buckets such as the Copernicus or Sentinel open data
# registries without credentials.
# AWS_NO_SIGN_REQUEST=YES
# AWS_REGION=eu-central-1

# Credentials for private buckets. Prefer instance roles or a credentials file
# over storing keys here.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# Parallelism and hardware
# -----------------------------------------------------------------------------

# Threads used by OpenMP in NumPy, scikit-learn, ONNX Runtime and PyTorch.
# Set it to the number of CPU cores available to the process.
# OMP_NUM_THREADS=4

# GPUs visible to PyTorch, CuPy and ONNX Runtime (comma-separated indices).
# CUDA_VISIBLE_DEVICES=0

# -----------------------------------------------------------------------------
# Proxies (corporate networks)
# -----------------------------------------------------------------------------
# HTTPS_PROXY=http://proxy.example.org:3128
# NO_PROXY=localhost,127.0.0.1
