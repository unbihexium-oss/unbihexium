# Abstract
# --------
# Copy this file to .env and adjust the values. docker-compose.yml reads .env
# automatically; for local runs, export the variables in your shell or use a
# tool such as direnv. Never commit the .env file: it may contain credentials.
#
# Every variable is optional. Commented-out variables show their default or an
# example value. A `#` after a value would become part of the value, so every
# comment stands on its own line above the variable it explains.
# =============================================================================

# -----------------------------------------------------------------------------
# Unbihexium
# -----------------------------------------------------------------------------

# Root directory of the local model store. Models are built from the model
# catalogue on first use, checked against their published SHA-256 digests and
# stored in $UNBIHEXIUM_CACHE/models. Default when unset: ~/.cache/unbihexium.
# docker-compose.yml sets it to the cache volume of the container.
# UNBIHEXIUM_CACHE=/data/unbihexium

# Log level of the library and of `unbihexium serve`: DEBUG, INFO, WARNING,
# ERROR or CRITICAL. Default: WARNING.
# UNBIHEXIUM_LOG_LEVEL=INFO

# YAML configuration file read by unbihexium.config.load_config.
# UNBIHEXIUM_CONFIG=/etc/unbihexium/config.yaml

# Any configuration value can be set as UNBIHEXIUM_<SECTION>__<KEY>; the
# sections are model, processing and serving (see unbihexium.config).

# Torch device of the REST service: cpu, cuda, cuda:<n> or mps. Default: cpu.
# UNBIHEXIUM_MODEL__DEVICE=cpu

# -----------------------------------------------------------------------------
# REST service (unbihexium serve)
# -----------------------------------------------------------------------------

# API key required in the X-API-Key header. Unset: no authentication.
# UNBIHEXIUM_SERVING__API_KEY=

# Requests per minute and client; 0 disables the limit. Default: 0.
# UNBIHEXIUM_SERVING__RATE_LIMIT_PER_MINUTE=60

# Allowed CORS origins, comma-separated. Default: every origin.
# UNBIHEXIUM_SERVING__CORS_ORIGINS=https://app.example.org

# Largest accepted request body in bytes. Default: 10485760 (10 MiB).
# UNBIHEXIUM_SERVING__MAX_REQUEST_BYTES=10485760

# Number of models kept loaded in memory. Default: 4.
# UNBIHEXIUM_SERVING__MODEL_CACHE_SIZE=4

# -----------------------------------------------------------------------------
# Python runtime
# -----------------------------------------------------------------------------

# Write log output immediately, which is recommended in containers.
PYTHONUNBUFFERED=1

# Do not write .pyc files, for example on read-only file systems.
# PYTHONDONTWRITEBYTECODE=1

# -----------------------------------------------------------------------------
# GDAL and rasterio (raster input and output)
# https://gdal.org/en/stable/user/configoptions.html
# -----------------------------------------------------------------------------

# Size of the GDAL block cache in megabytes.
# GDAL_CACHEMAX=512

# Threads used by GDAL for compression and warping (ALL_CPUS or a number).
# GDAL_NUM_THREADS=ALL_CPUS

# Speed up opening Cloud Optimized GeoTIFFs over HTTP and S3.
# GDAL_DISABLE_READDIR_ON_OPEN=EMPTY_DIR
# CPL_VSIL_CURL_ALLOWED_EXTENSIONS=.tif,.tiff,.jp2,.vrt

# Access to public S3 buckets such as the Copernicus or Sentinel open data
# registries without credentials.
# AWS_NO_SIGN_REQUEST=YES
# AWS_REGION=eu-central-1

# Credentials for private buckets. Prefer instance roles or a credentials file
# over storing keys here.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# Parallelism and hardware
# -----------------------------------------------------------------------------

# Threads used by OpenMP in NumPy, ONNX Runtime and PyTorch.
# Set it to the number of CPU cores available to the process.
# OMP_NUM_THREADS=4

# GPUs visible to a CUDA build of PyTorch (comma-separated indices). The
# container image contains the CPU build only.
# CUDA_VISIBLE_DEVICES=0

# -----------------------------------------------------------------------------
# Proxies (corporate networks)
# -----------------------------------------------------------------------------

# Proxy for outgoing HTTPS requests, for example STAC searches or remote
# rasters.
# HTTPS_PROXY=http://proxy.example.org:3128
# Hosts that are reached directly, without the proxy.
# NO_PROXY=localhost,127.0.0.1

