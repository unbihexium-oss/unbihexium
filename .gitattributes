# =============================================================================
# .gitattributes: line endings, binary files, Git LFS and GitHub linguist
# https://git-scm.com/docs/gitattributes
# =============================================================================

# -----------------------------------------------------------------------------
# Line endings
# Store every text file with LF line endings in the repository, whatever the
# platform of the contributor. Git detects binary files automatically.
# -----------------------------------------------------------------------------
* text=auto eol=lf

# -----------------------------------------------------------------------------
# Diff drivers: show the enclosing function or heading in diff hunks.
# -----------------------------------------------------------------------------
*.py diff=python
*.md diff=markdown
*.bash diff=bash
*.sh diff=bash

# -----------------------------------------------------------------------------
# Git LFS: model weights
# The starter weights of the model zoo are generated locally from the model
# id and are not committed (see src/unbihexium/zoo/catalog.yaml). Weight files
# that are committed anyway, for example fine-tuned checkpoints, are stored
# in Git LFS instead of the Git history.
# -----------------------------------------------------------------------------
*.onnx filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text

# -----------------------------------------------------------------------------
# Binary files tracked directly in Git
# -----------------------------------------------------------------------------
*.onnx.data binary
*.npy binary
*.npz binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.tif binary
*.tiff binary
*.ico binary
*.pdf binary

# -----------------------------------------------------------------------------
# GitHub linguist
# Keep documentation, notebooks, model cards and licence texts out of the
# language statistics so that the repository is classified as Python.
# -----------------------------------------------------------------------------
examples/notebooks/*.ipynb linguist-documentation
model_zoo/cards/** linguist-documentation
docs/** linguist-documentation
requirements*.txt linguist-generated

# -----------------------------------------------------------------------------
# git archive: exclude repository automation from source archives
# -----------------------------------------------------------------------------
.github/ export-ignore
.pre-commit-config.yaml export-ignore
