# Normalise line endings of all text files to LF in the repository.
* text=auto eol=lf

# Model weights are stored with Git LFS.
*.onnx filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text

# Other binary files tracked directly.
*.onnx.data binary
*.npy binary
*.png binary
*.jpg binary
*.tif binary

# Keep generated and documentation content out of the language statistics.
examples/notebooks/*.ipynb linguist-documentation
model_zoo/cards/** linguist-documentation
docs/** linguist-documentation
LICENSES/** linguist-vendored
