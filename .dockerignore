# Format      : Docker ignore patterns, read by docker build and BuildKit
# =============================================================================
#
# Abstract
# --------
# The Dockerfile copies only these paths into the image:
#
#   .github/requirements/requirements-docker.txt,
#   .github/requirements/requirements-ci-torch.txt, pyproject.toml,
#   README.md, LICENSE.txt, NOTICE, NOTICE.md and src/
#
# Everything else is excluded to keep the build context small, the layer cache
# stable and secrets, credentials and data out of the image. Do not exclude
# any of the paths listed above: the build fails without them.
#
# Patterns use Go filepath.Match syntax with `**` for any number of
# directories; a leading `!` re-includes a path. Docker reads a `#` only at
# the start of a line as a comment, so every comment stands on its own line
# above the pattern it explains.
# =============================================================================

# -----------------------------------------------------------------------------
# Version control and repository automation
# -----------------------------------------------------------------------------

# Git history and objects, which can be large and are not needed.
.git
# Git ignore rules.
.gitignore
# Git attributes.
.gitattributes
# Contributor identity map.
.mailmap
# GitHub workflows and repository scripts.
.github/
# Hashed lock file of the image dependencies, installed by the Dockerfile.
!.github/requirements/requirements-docker.txt
# Hashed lock file of the CPU build of PyTorch, installed by the Dockerfile.
!.github/requirements/requirements-ci-torch.txt
# GitLab CI configuration.
.gitlab-ci.yml
# pre-commit hook configuration.
.pre-commit-config.yaml

# -----------------------------------------------------------------------------
# Python bytecode, build output and packaging artefacts
# -----------------------------------------------------------------------------

# Bytecode cache at the top of the context.
__pycache__/
# Bytecode caches in every subdirectory.
**/__pycache__/
# Compiled, optimised and DLL bytecode files.
*.py[cod]
# Jython class files.
*$py.class
# Compiled C extensions built on the host.
*.so
# Python copy left by old virtualenv versions.
.Python
# Build directory of the packaging backend.
build/
# Development eggs of setuptools.
develop-eggs/
# Built wheels and source distributions.
dist/
# Download directory of old installers.
downloads/
# Installed eggs of zc.buildout.
eggs/
# Eggs fetched by setup_requires.
.eggs/
# Library directory of in-tree installations.
lib/
# 64-bit library directory of in-tree installations.
lib64/
# Parts directory of zc.buildout.
parts/
# Source distribution staging directory.
sdist/
# Variable data of in-tree installations.
var/
# Wheel cache directory.
wheels/
# Package metadata written by editable installs on the host.
*.egg-info/
# Installation record of zc.buildout.
.installed.cfg
# Egg archives.
*.egg
# Manifest generated by distutils.
MANIFEST

# -----------------------------------------------------------------------------
# Virtual environments and local environment files
# -----------------------------------------------------------------------------

# Virtual environment created by uv and `python -m venv .venv`.
.venv/
# Virtual environment with the traditional name.
venv/
# Virtual environment named env.
env/
# Virtual environment named ENV.
ENV/
# Local environment file, which may contain credentials.
.env
# Variants such as .env.local or .env.production.
.env.*
# The documented example file holds no secrets.
!.env.example

# -----------------------------------------------------------------------------
# Tool caches and reports
# -----------------------------------------------------------------------------

# Environments created by tox.
.tox/
# Environments created by nox.
.nox/
# Coverage data file.
.coverage
# Parallel coverage data files.
.coverage.*
# Coverage report in Cobertura XML format.
coverage.xml
# HTML coverage report.
htmlcov/
# Cache of pytest.
.pytest_cache/
# Example database of Hypothesis.
.hypothesis/
# Incremental cache of mypy.
.mypy_cache/
# Cache of the ruff linter and formatter.
.ruff_cache/
# Cache of pyright.
.pyright/
# Cache of the lychee link checker.
.lycheecache
# Generic tool cache directory.
.cache/

# -----------------------------------------------------------------------------
# Editors, IDEs and operating system files
# -----------------------------------------------------------------------------

# Project settings of JetBrains IDEs.
.idea/
# Workspace settings of Visual Studio Code.
.vscode/
# Vim swap files.
*.swp
# Additional Vim swap files.
*.swo
# Backup files of Emacs and other editors.
*~
# Project file of Eclipse.
.project
# Project file of PyDev.
.pydevproject
# Settings directory of Eclipse.
.settings/
# Folder metadata of macOS Finder.
.DS_Store
# Thumbnail cache of Windows Explorer.
Thumbs.db

# -----------------------------------------------------------------------------
# Documentation sources (not needed at runtime)
# -----------------------------------------------------------------------------

# Documentation sources.
docs/
# Markdown files, except those re-included below.
*.md
# README.md and NOTICE.md are package metadata (readme and licence file
# in pyproject.toml), so the build needs them.
!README.md
# Re-include the notice file referenced as a licence file in pyproject.toml.
!NOTICE.md

# -----------------------------------------------------------------------------
# Development, test and example content
# -----------------------------------------------------------------------------

# Test suite.
tests/
# Example scripts and the example REST service.
examples/
# Maintenance scripts.
scripts/
# Benchmarks.
benchmarks/
# Local build and experiment artefacts.
artifacts/
# Helm chart and Kubernetes manifests.
deploy/
# Development task runner.
Makefile
# tox configuration.
tox.ini
# Runtime lock file of users; the image installs its own lock files.
requirements.txt
# Development lock file.
requirements-dev.txt
# Codecov configuration.
codecov.yml
# yamllint configuration.
.yamllint.yml
# markdownlint configuration.
.markdownlint.yaml
# EditorConfig settings.
.editorconfig

# -----------------------------------------------------------------------------
# Model zoo and data. Model weights are downloaded into the cache at runtime
# and verified with SHA256; they are never baked into the image.
# -----------------------------------------------------------------------------

# Model zoo cards, checksums and weights.
model_zoo/
# PyTorch checkpoints.
*.pt
# PyTorch state dictionaries.
*.pth
# ONNX models.
*.onnx
# External tensor data of large ONNX models.
*.onnx.data
# safetensors weight files.
*.safetensors
# Darknet and other raw weight files.
*.weights
# HDF5 files with the .h5 extension, for example Keras models.
*.h5
# HDF5 files with the .hdf5 extension.
*.hdf5
# Pickled Python objects.
*.pkl
# Objects saved with joblib.
*.joblib
# NumPy arrays.
*.npy
# GeoTIFF rasters with the .tif extension.
*.tif
# GeoTIFF rasters with the .tiff extension.
*.tiff
# NetCDF files.
*.nc
# Zarr stores.
*.zarr/
# GeoJSON vector data.
*.geojson
# Shapefiles.
*.shp
# GeoPackage files.
*.gpkg
# Apache Parquet tables.
*.parquet

# -----------------------------------------------------------------------------
# Secrets and credentials. Never send these to the Docker daemon.
# -----------------------------------------------------------------------------

# Directory for local secrets.
secrets/
# PEM certificates and private keys.
*.pem
# Private keys.
*.key
# PKCS #12 key stores.
*.p12
# PKCS #12 key stores with the Windows extension.
*.pfx
# Certificates.
*.crt
# Credentials for FTP and HTTP clients.
.netrc
# PyPI upload credentials.
.pypirc
# AWS credentials and configuration.
.aws/
# Azure CLI credentials.
.azure/
# Google Cloud SDK credentials.
.config/gcloud/

# -----------------------------------------------------------------------------
# Logs and temporary files
# -----------------------------------------------------------------------------

# Log files.
*.log
# Log directories.
logs/
# Temporary directory named tmp.
tmp/
# Temporary directory named temp.
temp/
# Temporary files.
*.tmp
# Backup files.
*.bak

# =============================================================================
# End of file .dockerignore
