# =============================================================================
# .dockerignore: files excluded from the Docker build context
# =============================================================================
#
# The Dockerfile copies only these paths into the image:
#   requirements.txt, pyproject.toml, README.md, LICENSE.txt, NOTICE,
#   NOTICE.md and src/
#
# Everything else is excluded to keep the build context small, the layer cache
# stable and secrets, credentials and data out of the image. Do not exclude
# any of the paths listed above: the build fails without them.
# =============================================================================

# -----------------------------------------------------------------------------
# Version control and repository automation
# -----------------------------------------------------------------------------
.git
.gitignore
.gitattributes
.mailmap
.github/
.gitlab-ci.yml
.pre-commit-config.yaml

# -----------------------------------------------------------------------------
# Python bytecode, build output and packaging artefacts
# -----------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# -----------------------------------------------------------------------------
# Virtual environments and local environment files
# -----------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example

# -----------------------------------------------------------------------------
# Tool caches and reports
# -----------------------------------------------------------------------------
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.pyright/
.lycheecache
.cache/

# -----------------------------------------------------------------------------
# Editors, IDEs and operating system files
# -----------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/
.DS_Store
Thumbs.db

# -----------------------------------------------------------------------------
# Documentation sources (not needed at runtime)
# -----------------------------------------------------------------------------
docs/
site/
*.md
!README.md

# -----------------------------------------------------------------------------
# Development, test and example content
# -----------------------------------------------------------------------------
tests/
examples/
scripts/
benchmarks/
artifacts/
deploy/
Makefile
tox.ini
requirements-dev.txt
codecov.yml
.yamllint.yml
.markdownlint.yaml
.editorconfig

# -----------------------------------------------------------------------------
# Model zoo and data. Model weights are downloaded into the cache at runtime
# and verified with SHA256; they are never baked into the image.
# -----------------------------------------------------------------------------
model_zoo/
*.pt
*.pth
*.onnx
*.onnx.data
*.safetensors
*.weights
*.h5
*.hdf5
*.pkl
*.joblib
*.npy
*.tif
*.tiff
*.nc
*.zarr/
*.geojson
*.shp
*.gpkg
*.parquet

# -----------------------------------------------------------------------------
# Secrets and credentials. Never send these to the Docker daemon.
# -----------------------------------------------------------------------------
secrets/
*.pem
*.key
*.p12
*.pfx
*.crt
.netrc
.pypirc
.aws/
.azure/
.config/gcloud/

# -----------------------------------------------------------------------------
# Logs and temporary files
# -----------------------------------------------------------------------------
*.log
logs/
tmp/
temp/
*.tmp
*.bak
