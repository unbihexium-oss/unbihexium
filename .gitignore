# =============================================================================
# .gitignore: files that must never be committed
# =============================================================================
#
# Organised by origin. Patterns follow gitignore(5):
#   https://git-scm.com/docs/gitignore
#
# Notes
#   - Model weights (*.onnx, *.pt) under model_zoo/ are committed through Git
#     LFS and are therefore NOT ignored (see .gitattributes).
#   - .env.example is committed on purpose; real .env files are ignored.
#   - Test fixtures under tests/fixtures/ are committed even when their file
#     type is ignored elsewhere.
# =============================================================================

# -----------------------------------------------------------------------------
# Python: bytecode, extensions and packaging
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# -----------------------------------------------------------------------------
# Virtual environments and environment files
# -----------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
__pypackages__/
.env
.env.*
!.env.example
*.local.yaml

# pyenv and uv interpreter pins are local choices; the supported versions are
# defined in pyproject.toml.
.python-version

# Other package managers. The project lock files are requirements*.txt.
Pipfile.lock
poetry.lock
uv.lock
pdm.lock
.pdm.toml
.pdm-python
.pdm-build/

# -----------------------------------------------------------------------------
# Tests, coverage and tool caches
# -----------------------------------------------------------------------------
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
*.cover
*.py,cover
htmlcov/
nosetests.xml
.hypothesis/
.pytest_cache/
cover/
.cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/
.pyright/
.lycheecache
cython_debug/
.requirements*.tmp
.requirements*.orig

# Copy of LICENSE.txt that `make licence`, `tox -e licence` and the License
# Compliance workflow create for `reuse lint`. The repository keeps a single
# licence text, LICENSE.txt, at the root.
/LICENSES/

# -----------------------------------------------------------------------------
# Documentation build output
# -----------------------------------------------------------------------------
/site/
docs/_build/

# -----------------------------------------------------------------------------
# Jupyter and IPython
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
profile_default/
ipython_config.py

# -----------------------------------------------------------------------------
# Editors, IDEs and operating systems
# -----------------------------------------------------------------------------
.vscode/
.idea/
.spyderproject
.spyproject
.ropeproject
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# -----------------------------------------------------------------------------
# Geospatial and scientific data. Large inputs and outputs are kept out of
# Git; small test fixtures are allowed explicitly.
# -----------------------------------------------------------------------------
*.tif
*.tiff
*.nc
*.hdf5
*.h5
*.zarr/
!tests/fixtures/**/*.tif

# Model zoo download cache used by unbihexium.zoo during development.
.unbihexium_cache/

# -----------------------------------------------------------------------------
# Secrets and credentials
# -----------------------------------------------------------------------------
secrets/
*.pem
*.key
*.p12
*.pfx
.netrc
.pypirc

# -----------------------------------------------------------------------------
# Logs and temporary files
# -----------------------------------------------------------------------------
*.log
logs/
*.tmp
*.temp
*.bak
.pre-commit-config.yaml.bak

# -----------------------------------------------------------------------------
# Web framework defaults that some examples may create
# -----------------------------------------------------------------------------
instance/
.webassets-cache
local_settings.py
db.sqlite3
db.sqlite3-journal
