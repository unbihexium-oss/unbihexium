{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/unbihexium-oss/unbihexium/blob/main/model_zoo/manifest.schema.json",
  "title": "Unbihexium model zoo manifest",
  "description": "Manifest of one model family of the Unbihexium model zoo. Manifests are generated from src/unbihexium/zoo/catalog.yaml by `python -m unbihexium.zoo.sync`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "family",
    "name",
    "version",
    "task",
    "domain",
    "architecture",
    "license",
    "status",
    "trained",
    "description",
    "inputs",
    "outputs",
    "training_labels",
    "data_sources",
    "variants"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "family": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*[a-z0-9]$",
      "description": "Model family identifier."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Version of the catalogue the manifest was generated from."
    },
    "task": {
      "enum": [
        "detection",
        "segmentation",
        "change_detection",
        "dense_regression",
        "scene_regression",
        "enhancement",
        "super_resolution",
        "spectral_index"
      ]
    },
    "domain": {
      "type": "string"
    },
    "architecture": {
      "enum": [
        "centernet",
        "unet",
        "unet_early_fusion",
        "unet_regression",
        "encoder_regressor",
        "unet_image_to_image",
        "residual_subpixel",
        "spectral_formula"
      ]
    },
    "license": {
      "const": "MPL-2.0"
    },
    "status": {
      "enum": [
        "starter",
        "reference"
      ],
      "description": "starter: trainable architecture with deterministic starter weights, not trained; reference: exact implementation of a published formula."
    },
    "trained": {
      "type": "boolean",
      "description": "Whether the published weights were trained on Earth observation data."
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bands",
        "dates",
        "channels"
      ],
      "properties": {
        "bands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "dates": {
          "type": "integer",
          "minimum": 1
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "names",
        "units",
        "range",
        "scale",
        "formula",
        "layout"
      ],
      "properties": {
        "names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "units": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "range": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "scale": {
          "type": "integer",
          "minimum": 1
        },
        "formula": {
          "type": [
            "string",
            "null"
          ]
        },
        "layout": {
          "type": "string"
        }
      }
    },
    "training_labels": {
      "type": "string"
    },
    "data_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "variants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tiny",
        "base",
        "large",
        "mega"
      ],
      "patternProperties": {
        "^(tiny|base|large|mega)$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model_id",
            "tile_size",
            "base_channels",
            "depth",
            "num_parameters",
            "weights_digest"
          ],
          "properties": {
            "model_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*_(tiny|base|large|mega)$"
            },
            "tile_size": {
              "type": "integer",
              "minimum": 32
            },
            "base_channels": {
              "type": "integer",
              "minimum": 1
            },
            "depth": {
              "type": "integer",
              "minimum": 1
            },
            "num_parameters": {
              "type": "integer",
              "minimum": 0
            },
            "weights_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    }
  }
}
