# =============================================================================
# EditorConfig: consistent formatting across editors and IDEs
# https://editorconfig.org/
# =============================================================================
#
# Most editors apply these settings automatically, some through a plugin.
# They match the formatters and linters used in CI:
#   - Python: ruff format (line length 100, see pyproject.toml)
#   - YAML:   yamllint (.yamllint.yml)
#   - Markdown: markdownlint (.markdownlint.yaml)
# =============================================================================

root = true

# Defaults for every file: UTF-8, LF line endings, a final newline, no
# trailing whitespace and four-space indentation.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Python source code, formatted by ruff.
[*.{py,pyi}]
indent_size = 4
max_line_length = 100

# Data and configuration formats conventionally indented with two spaces.
[*.{json,jsonld,yaml,yml,cff,toml}]
indent_size = 2

# pyproject.toml and tox.ini use four spaces for nested lists.
[{pyproject.toml,tox.ini}]
indent_size = 4

# Jupyter notebooks are written by nbformat with one-space indentation.
# Keep it so that notebook diffs stay minimal.
[*.ipynb]
indent_size = 1

# Markdown: trailing double spaces can be meaningful line breaks.
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# Shell scripts.
[*.{sh,bash}]
indent_size = 4

# Makefiles require tabs for recipes.
[{Makefile,*.mk}]
indent_style = tab

# Licence texts are kept verbatim.
[LICENSE.txt]
trim_trailing_whitespace = false
insert_final_newline = unset
indent_style = unset
indent_size = unset

# Lock files are generated by uv; do not reformat them.
[requirements*.txt]
indent_size = unset
