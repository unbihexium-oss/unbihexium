# Format      : EditorConfig (INI-like), read by editors and IDEs
# =============================================================================
#
# Abstract
# --------
# Most editors apply these settings automatically, some through a plugin
# (https://editorconfig.org/). They match the formatters and linters used in
# CI:
#
#   Python    ruff format (line length 100, see pyproject.toml)
#   YAML      yamllint (.yamllint.yml)
#   Markdown  markdownlint (.markdownlint.yaml)
#
# Later sections override earlier ones for the files they match. A `#` after
# a value would become part of the value in some parsers, so every comment
# stands on its own line above the setting it explains.
# =============================================================================

# Stop the search for further .editorconfig files in parent directories.
root = true

# Defaults for every file in the repository.
[*]
# Read and write files as UTF-8.
charset = utf-8
# Use LF line endings, matching the eol=lf rule in .gitattributes.
end_of_line = lf
# End every file with a newline, as POSIX tools expect.
insert_final_newline = true
# Remove trailing whitespace, which only produces noisy diffs.
trim_trailing_whitespace = true
# Indent with spaces rather than tabs.
indent_style = space
# Indent by four spaces unless a later section says otherwise.
indent_size = 4

# Python source code, formatted by ruff.
[*.{py,pyi}]
# Four-space indentation as required by PEP 8.
indent_size = 4
# Same line length as the ruff configuration in pyproject.toml.
max_line_length = 100

# Data and configuration formats conventionally indented with two spaces.
[*.{json,jsonld,yaml,yml,cff,toml}]
# Two-space indentation for nested mappings and lists.
indent_size = 2

# pyproject.toml and tox.ini use four spaces for nested lists.
[{pyproject.toml,tox.ini}]
# Override the two-space TOML default above for these two files.
indent_size = 4

# Jupyter notebooks, written by nbformat.
[*.ipynb]
# nbformat indents by one space; keeping it makes notebook diffs minimal.
indent_size = 1

# Markdown documentation.
[*.md]
# Two trailing spaces can be a meaningful hard line break in Markdown.
trim_trailing_whitespace = false
# Two-space indentation for nested lists.
indent_size = 2

# Shell scripts.
[*.{sh,bash}]
# Four-space indentation, as in the Python sources.
indent_size = 4

# Makefiles.
[{Makefile,*.mk}]
# GNU make requires a tab at the start of every recipe line.
indent_style = tab

# Licence texts, which are kept verbatim.
[LICENSE.txt]
# Keep the whitespace of the original text.
trim_trailing_whitespace = false
# Do not add or remove a final newline.
insert_final_newline = unset
# Do not enforce an indentation style.
indent_style = unset
# Do not enforce an indentation width.
indent_size = unset

# Lock files generated by uv.
[requirements*.txt]
# Keep the indentation written by uv so that the files are not reformatted.
indent_size = unset

# =============================================================================
# End of file .editorconfig
