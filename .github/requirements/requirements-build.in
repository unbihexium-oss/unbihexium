# Abstract
# --------
# The build backend of pyproject.toml ([build-system] requires). The
# Dockerfile builds the wheel of the package with
#   pip wheel --no-deps --no-build-isolation
# in a separate environment that holds only this lock, so the backend is
# pinned by hash like every other dependency instead of being fetched from
# PyPI by an isolated build (OpenSSF Scorecard, Pinned-Dependencies). The
# release and package workflows install the same backend from
# requirements-ci-tools.txt and run `python -m build --no-isolation`. Keep
# the lower bound in step with pyproject.toml.
# =============================================================================

hatchling>=1.27.0  # Build backend; 1.27 is the first release with PEP 639 licence expressions.

