# Abstract
# --------
# Linters, security scanners, build and licence tools that the GitHub
# Actions workflows install. `make lock` compiles this file into
# requirements-ci-tools.txt with a SHA-256 hash for every distribution, and
# the workflows install it with `pip install --require-hashes`, so a job
# only ever runs the reviewed files (OpenSSF Scorecard, Pinned-Dependencies).
#
# Versions that also appear in .pre-commit-config.yaml are pinned here to
# the same release, so that CI and the local hooks agree.
# =============================================================================

ruff==0.16.8  # Linter and formatter; same release as the pre-commit hook.
pyright  # Static type checker.
bandit[toml]==1.9.4  # Security linter; same release as the pre-commit hook.
pip-audit  # Known vulnerabilities in dependencies.
build  # PEP 517 build frontend for the sdist and the wheel.
twine  # Metadata check of the distributions.
reuse==6.2.0  # REUSE licensing lint; same release as the pre-commit hook.
pip-licenses  # Licences of the installed dependencies.
check-jsonschema==0.38.1  # JSON Schema validation; same release as the pre-commit hook.
yamllint==1.38.0  # YAML lint; same release as the pre-commit hook.
pyyaml  # YAML parser for the repository scripts.
jsonschema  # JSON Schema validation of the model manifests.
uv  # Lock file compiler used by the torch lock workflow.
hatchling>=1.27.0  # Build backend for `python -m build --no-isolation`; keep in step with pyproject.toml.

